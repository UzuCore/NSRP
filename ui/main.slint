                    if root.selected-tab == 2 : TouchArea { x:640px; y:619px; width:171px; height:20px; clicked => { root.notify-done = !root.notify-done; } }
                    if root.selected-tab == 3 : TouchArea { x:640px; y:617px; width:171px; height:20px; clicked => { root.notify-done = !root.notify-done; } }
                    if root.selected-tab == 4 : TouchArea { x:640px; y:621px; width:171px; height:20px; clicked => { root.notify-done = !root.notify-done; } }
                    if root.selected-tab == 5 : TouchArea { x:434px; y:621px; width:171px; height:20px; clicked => { root.notify-done = !root.notify-done; } }
                    if root.selected-tab == 6 : TouchArea { x:515px; y:621px; width:171px; height:20px; clicked => { root.notify-done = !root.notify-done; } }
                    if root.selected-tab == 6 : TouchArea { x:692px; y:621px; width:119px; height:20px; clicked => { root.remove-source = !root.remove-source; } }
                    merge-compress-hit := TouchArea { x:202px; y:537px; width:91px; height:20px; enabled:root.selected-tab == 7; clicked => { root.compress-after = !root.compress-after; } }
                    if root.selected-tab == 7 : TouchArea { x:523px; y:621px; width:171px; height:20px; clicked => { root.notify-done = !root.notify-done; } }
                    merge-title-hit := TouchArea { x:700px; y:621px; width:111px; height:20px; enabled:root.selected-tab == 7; clicked => { root.use-game-title = !root.use-game-title; } }
                    if root.selected-tab == 8 : TouchArea { x:523px; y:621px; width:171px; height:20px; clicked => { root.notify-done = !root.notify-done; } }
                    split-title-hit := TouchArea { x:700px; y:621px; width:111px; height:20px; enabled:root.selected-tab == 8; clicked => { root.use-game-title = !root.use-game-title; } }

                    if extract-nca-hit.has-hover : LegacyTooltip {
                        x:22px; y:486px; width:315px; height:42px;
                        text:"데이터 분해를 위해 암호화 키(prod.keys)가 필요합니다.";
                    }
                    if convert-options-hit.has-hover && convert-options-hit.mouse-x >= 119px : LegacyTooltip {
                        x:212px; y:443px; width:430px; height:82px;
                        text:"체크 시 결과를 압축 포맷으로 출력합니다.\n• NSP 선택 + 체크 → NSZ\n• XCI 선택 + 체크 → XCZ\n체크 해제 시 입력이 NSZ/XCZ 여도 NSP/XCI 로만 출력됩니다.";
                    }
                    if compress-options-hit.has-hover && compress-options-hit.mouse-x >= 125px : LegacyTooltip {
                        x:430px; y:558px; width:381px; height:56px;
                        text:"블록 모드: 1MB 단위 독립 압축 (에뮬레이터 직접 마운트 호환)\n블록리스 모드: 파일 크기가 더 작음 (일반 설치 권장)";
                    }
                    if merge-compress-hit.has-hover : LegacyTooltip {
                        x:202px; y:443px; width:430px; height:82px;
                        text:"체크 시 결과를 압축 포맷으로 출력합니다.\n• NSP 선택 + 체크 → NSZ\n• XCI 선택 + 체크 → XCZ\n체크 해제 시 입력이 NSZ/XCZ 여도 NSP/XCI 로만 출력됩니다.";
                    }
                    if merge-title-hit.has-hover : LegacyTooltip {
                        x:390px; y:541px; width:421px; height:73px;
                        text:"체크 시 게임 내부 타이틀을 한국어 → 영어 → 일본어 순으로 가져와 출력 파일명에 사용합니다.\n체크 해제 시 원본 파일명을 사용합니다.";
                    }
                    if split-title-hit.has-hover : LegacyTooltip {
                        x:390px; y:541px; width:421px; height:73px;
                        text:"체크 시 게임 내부 타이틀을 한국어 → 영어 → 일본어 순으로 가져와 출력 파일명에 사용합니다.\n체크 해제 시 원본 파일명을 사용합니다.";
                    }
                    if root.patch-analyzing && root.selected-tab == 0 : TouchArea { x:0px; y:24px; width:835px; height:668px; }
                    if root.busy : TouchArea { x:0px; y:24px; width:835px; height:668px; }
                    if root.busy && root.selected-tab <= 2 : TouchArea { x:418px; y:645px; width:391px; height:36px; enabled:!root.stop-requested; clicked => { root.stop-operation(); } }
                    if root.busy && root.selected-tab == 3 : TouchArea { x:419px; y:645px; width:390px; height:36px; enabled:!root.stop-requested; clicked => { root.stop-operation(); } }
                    if root.busy && root.selected-tab >= 4 : TouchArea { x:20px; y:646px; width:789px; height:36px; enabled:!root.stop-requested; clicked => { root.stop-operation(); } }
}
            }

            Rectangle {
                width: 540px;
                background: #f0f0f0;
                Rectangle {
                    width: parent.width; height: parent.height;
                    background: #f9f9f9;
                    border-width: 1px; border-color: #e5e5e5;
                    Image { x:0px; y:0px; width:540px; height:25px; source:@image-url("legacy_assets/log_topstrip_full.png"); }
                    QtLogView { x: 2px; y: 25px; width: 534px; height: 668px; rows: root.log-rows; }
                }
            }
        }

        Rectangle {
            height: 21px; background: #f0f0f0; border-width: 0px;
            HorizontalLayout {
                padding-left: 12px; padding-right: 20px; spacing: 6px;
                Text { text: root.status-text; color: #000000; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                StatusProgress { width: 180px; progress: root.progress; }
                ResourceLabel { text: root.resource-text; char-count: root.resource-char-count; }
            }
        }
    }

    if root.menu-open != 0 : TouchArea {
        x: 0px; y: 22px; width: parent.width; height: parent.height - 22px;
        clicked => { root.menu-open = 0; }
    }
    if root.menu-open == 1 : Image {
        x: 0px; y: 22px; width: 98px; height: 30px; source:file-exit-menu.has-hover ? @image-url("legacy_assets/menu_file_hover.png") : @image-url("legacy_assets/menu_file.png");
        file-exit-menu := TouchArea { x:3px; y:3px; width:91px; height:24px; clicked => { root.menu-open = 0; root.exit-app(); } }
    }
    if root.menu-open == 2 : Image {
        x: 40px; y: 22px; width: 150px; height: 63px;
        source:help-update-menu.has-hover ? @image-url("legacy_assets/menu_help_update_hover.png") : (help-info-menu.has-hover ? @image-url("legacy_assets/menu_help_info_hover.png") : @image-url("legacy_assets/menu_help.png"));
        help-update-menu := TouchArea { x:3px; y:3px; width:143px; height:24px; clicked => { root.menu-open = 0; root.open-updates(); } }
        help-info-menu := TouchArea { x:3px; y:36px; width:143px; height:24px; clicked => { root.menu-open = 0; root.show-about(); } }
    }
    // All recovery controls are read-only: no restore, delete or rename.
    if root.recovery-open : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #00000055;
        TouchArea { width: parent.width; height: parent.height; }
    }
    if root.recovery-open : Rectangle {
        x: 180px; y: 72px; width: 1040px; height: 616px;
        background: #ffffff;
        border-width: 1px; border-color: #7c8795;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: 45px;
            background: #f0f2f5;
            Text {
                x: 18px; width: 590px; height: parent.height;
                text: "Program 복구 이력 (읽기 전용)";
                font-size: 16px; font-weight: 700; color: #202124;
                vertical-alignment: center;
            }
            LegacyButton {
                x: 948px; y: 6px; width: 74px; height: 30px;
                text: "닫기";
                clicked => { root.recovery-open = false; }
            }
        }
        Text {
            x: 18px; y: 52px; width: 1000px; height: 30px;
            text: "원본/백업/임시 폴더를 직접 대조하기 전에는 이동·삭제·자동 복원을 수행하지 마세요.";
            color: #9b2118; font-size: 12px; font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            x: 18px; y: 91px; width: 96px; height: 25px;
            text: "검사 위치:"; font-size: 12px;
            vertical-alignment: center; color: #202124;
        }
        Rectangle {
            x: 112px; y: 90px; width: 678px; height: 29px;
            border-width: 1px; border-color: #c5cbd2;
            background: #f8f9fb;
            Text {
                x: 8px; width: parent.width - 16px; height: parent.height;
                text: root.recovery-root; font-size: 12px; color: #202124;
                vertical-alignment: center; overflow: elide;
            }
        }
        LegacyButton {
            x: 797px; y: 90px; width: 102px; height: 30px;
            text: "폴더 선택";
            enabled: !root.recovery-loading;
            clicked => { root.choose-recovery-root(); }
        }
        LegacyButton {
            x: 905px; y: 90px; width: 117px; height: 30px;
            text: root.recovery-loading ? "검사 중..." : "새로고침";
            enabled: !root.recovery-loading;
            clicked => { root.refresh-recovery(); }
        }
        Text {
            x: 18px; y: 130px; width: 975px; height: 28px;
            text: root.recovery-loading ? "복구 저널을 안전하게 읽는 중입니다." : "발견된 복구 기록: " + root.recovery-count + "개  |  자동 복원/정리: 사용 안 함";
            font-size: 12px; color: #202124; vertical-alignment: center;
        }
        Rectangle {
            x: 18px; y: 162px; width: 1004px; height: 381px;
            background: #ffffff; border-width: 1px; border-color: #b5bdc7;
            ListView {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                for line in root.recovery-lines : Rectangle {
                    // Long recovery paths must be scrollable instead of being
                    // silently cut off by a fixed-height, two-line row.
                    width: parent.width;
                    height: max(49px, min(180px, recovery-row-text.preferred-height + 12px));
                    background: #f8f9fb;
                    recovery-row-text := Text {
                        x: 10px; y: 6px; width: parent.width - 22px; height: parent.height - 12px;
                        text: line; font-size: 12px; color: #202124;
                        wrap: word-wrap; vertical-alignment: top;
                    }
                }
            }
        }
        Text {
            x: 18px; y: 553px; width: 1004px; height: 54px;
            text: "안전 주의: 이력은 실제 파일 변경의 최종 상태를 증명하지 않습니다.\n손상된 저널·정션·링크는 자동 처리하지 않으며 사용자 파일을 수정하지 않습니다.";
            font-size: 12px; color: #9b2118; wrap: word-wrap;
            vertical-alignment: center;
        }
    }

    // Other NSRP confirmation/error popups use native Windows dialogs (rfd).
    // Match their undecorated white content, standard caption and bottom
    // action band here while retaining the actual licensed AboutSlint widget.
    if root.about-open : TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
    }
    if root.about-open : Rectangle {
        x: (parent.width - 620px) / 2 + 4px;
        y: (parent.height - 440px) / 2 + 6px;
        width: 620px; height: 440px;
        border-radius: 6px;
        background: #0000001f;
    }
    if root.about-open : Rectangle {
        x: (parent.width - 620px) / 2;
        y: (parent.height - 440px) / 2;
        width: 620px; height: 440px;
        background: #ffffff;
        border-width: 1px; border-color: #b8bec6;
        border-radius: 6px;
        clip: true;

        // A Windows-style caption, not a second colored application header.
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: 46px;
            background: #ffffff;
            Text {
                x: 18px; width: parent.width - 88px; height: parent.height;
                text: "NSRP 정보"; color: #202124; font-size: 13px;
                font-weight: 600; vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 47px; y: 0px; width: 46px; height: 33px;
                background: about-caption-close.has-hover ? #e81123 : #ffffff;
                Text {
                    width: parent.width; height: parent.height;
                    text: "×"; font-size: 20px; font-weight: 300;
                    color: about-caption-close.has-hover ? #ffffff : #333333;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                about-caption-close := TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.about-open = false; }
                }
            }
        }

        // Plain native-dialog content with a scrollable long workspace path.
        ScrollView {
            x: 23px; y: 65px; width: parent.width - 46px; height: 148px;
            viewport-width: self.width;
            viewport-height: max(self.height, about-detail-text.preferred-height + 16px);
            about-detail-text := Text {
                x: 2px; y: 3px; width: parent.width - 18px;
                height: self.preferred-height;
                text: root.about-details; color: #202124;
                font-size: 12px; wrap: word-wrap;
                vertical-alignment: top;
            }
        }
        Rectangle {
            x: 23px; y: 219px; width: parent.width - 46px; height: 1px;
            background: #e5e5e5;
        }
        Text {
            x: 23px; y: 229px; width: parent.width - 46px; height: 23px;
            text: "UI 프레임워크 · Slint (로열티 프리 데스크톱 라이선스 2.0)";
            color: #60666e; font-size: 12px; vertical-alignment: center;
        }
        AboutSlint {
            x: 23px; y: 254px; width: 312px; height: 124px;
        }

        // Same bottom button band used by native confirmation dialogs.
        Rectangle {
            x: 1px; y: parent.height - 54px;
            width: parent.width - 2px; height: 53px;
            background: #f5f5f5;
            Rectangle {
                width: parent.width; height: 1px; background: #dedede;
            }
            Rectangle {
                x: parent.width - 116px; y: 10px;
                width: 96px; height: 32px;
                background: about-ok-touch.has-hover ? #eaf2fa : #ffffff;
                border-width: 1px;
                border-color: about-ok-touch.has-hover ? #0078d4 : #929292;
                border-radius: 3px;
                Text {
                    width: parent.width; height: parent.height;
                    text: "확인"; color: #202124; font-size: 12px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                about-ok-touch := TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.about-open = false; }
                }
            }
        }
    }

}
