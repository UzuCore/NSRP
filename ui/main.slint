    LegacyLineEdit { x:132px; y:12px; width:635px; height:22px; text:root.content-data.title-id; read-only:true; }
    if !root.dlc-mode : FieldLabel { x:16px; y:40px; width:110px; height:22px; text:"버전"; }
    if !root.dlc-mode : LegacyLineEdit { x:132px; y:40px; width:635px; height:22px; text:root.content-data.version; read-only:true; }
    if !root.dlc-mode : FieldLabel { x:16px; y:68px; width:110px; height:22px; text:"최소 시스템 버전"; }
    if !root.dlc-mode : LegacyLineEdit { x:132px; y:68px; width:635px; height:22px; text:root.content-data.system-version; read-only:true; }
    FieldLabel { x:16px; y:root.dlc-mode ? 40px : 96px; width:110px; height:22px; text:"빌드 ID"; }
    LegacyLineEdit { x:132px; y:root.dlc-mode ? 40px : 96px; width:635px; height:22px; text:root.content-data.build-id; read-only:true; }
}

component AnalyzeContentTree inherits Rectangle {
    in property <[ContentRow]> rows;
    in property <bool> dlc-mode: false;
    background: #ffffff;
    border-width: 1px;
    border-color: #b8b8b8;
    Rectangle {
        x:1px; y:1px; width:parent.width - 2px; height:24px; background:#f5f5f5;
        Text { x:8px; width:36px; height:24px; text:"#"; color:#000000; font-size:12px; vertical-alignment:center; }
        Text { x:48px; width:165px; height:24px; text:"타이틀 ID"; color:#000000; font-size:12px; vertical-alignment:center; }
        if !root.dlc-mode : Text { x:218px; width:72px; height:24px; text:"버전"; color:#000000; font-size:12px; vertical-alignment:center; }
        if !root.dlc-mode : Text { x:294px; width:130px; height:24px; text:"최소 시스템 버전"; color:#000000; font-size:12px; vertical-alignment:center; }
        Text { x:root.dlc-mode ? 218px : 430px; width:root.dlc-mode ? 520px : 310px; height:24px; text:"빌드 ID"; color:#000000; font-size:12px; vertical-alignment:center; }
    }
    ListView {
        x:1px; y:25px; width:parent.width - 2px; height:parent.height - 26px;
        for row[index] in root.rows : Rectangle {
            width:parent.width; height:18px; background:#ffffff;
            Text { x:8px; width:36px; height:18px; text:index + 1; color:#000000; font-size:12px; vertical-alignment:center; overflow:elide; }
            Text { x:48px; width:165px; height:18px; text:row.title-id; color:#000000; font-size:12px; vertical-alignment:center; overflow:elide; }
            if !root.dlc-mode : Text { x:218px; width:72px; height:18px; text:row.version; color:#000000; font-size:12px; vertical-alignment:center; overflow:elide; }
            if !root.dlc-mode : Text { x:294px; width:130px; height:18px; text:row.system-version; color:#000000; font-size:12px; vertical-alignment:center; overflow:elide; }
            Text { x:root.dlc-mode ? 218px : 430px; width:root.dlc-mode ? 520px : 310px; height:18px; text:row.build-id; color:#000000; font-size:12px; vertical-alignment:center; overflow:elide; }
        }
    }
}

component QtTabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    height: 24px;
    background: root.selected ? #f9f9f9 : #f0f0f0;
    if root.selected : Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: #e5e5e5; }
    if !root.selected : Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: #e5e5e5; }
    if !root.selected : Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: #e5e5e5; }
    Text {
        text: root.text;
        color: root.enabled ? #000000 : #808080;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { x:0px; y:0px; width:parent.width; height:parent.height; enabled:root.enabled; clicked => { root.clicked(); } }
}

export struct LogRow {
    text: string,
    tone: int,
}

component QtLogView inherits Rectangle {
    in property <[LogRow]> rows;
    background: transparent;
    if root.rows.length == 0 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/log_empty.png"); }
    if root.rows.length > 0 : Rectangle {
        width:parent.width; height:parent.height; background:#ffffff; border-width:1px; border-color:#b8b8b8;
        ListView {
            x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 8px;
            for row in root.rows : Text {
                width: parent.width;
                height: 16px;
                text: row.text;
                color: row.tone == 1 ? #2da44e : (row.tone == 2 ? #b07d00 : (row.tone == 3 ? #cf222e : (row.tone == 4 ? #24292f : #57606a)));
                font-family: "맑은 고딕";
                font-size: 12px;
                font-weight: row.tone == 1 || row.tone == 4 ? 700 : 400;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
export component AppWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.light; }
    title: "NSRP v" + root.app-version;
    preferred-width: 1400px;
    preferred-height: 760px;
    min-width: 1400px;
    min-height: 760px;
    background: #f0f0f0;
    default-font-family: "맑은 고딕";
    default-font-size: 12px;
    default-font-weight: 400;

    in-out property <string> app-version: "";
    in-out property <int> selected-tab: 0;
    in-out property <int> menu-open: 0;
    in-out property <string> input-paths: "";
    in-out property <string> patch-paths: "";
    in-out property <[StandardListViewItem]> input-items: [];
    in-out property <[StandardListViewItem]> patch-items: [];
    in-out property <int> input-current: -1;
    in-out property <int> patch-current: -1;
    in-out property <string> output-dir: "";
    in-out property <string> status-text: "대기";
    in-out property <string> log-text: "";
    in-out property <[LogRow]> log-rows: [];
    in-out property <[TreeRow]> extract-rows: [];
    in-out property <bool> extract-analyzing: false;
    in-out property <string> resource-text: "";
    in-out property <int> resource-char-count: 0;
    in-out property <float> progress: 0;
    in-out property <float> compression-level: 18;
    in-out property <float> thread-count: 1;
    in-out property <int> core-count: 1;
    in-out property <bool> remove-source: false;
    in-out property <bool> block-mode: true;
    in-out property <bool> notify-done: false;
    in-out property <bool> save-log: false;
    in-out property <bool> compress-after: false;
    in-out property <bool> use-game-title: true;
    in-out property <bool> unpack-nca: false;
    in-out property <string> patch-analysis-text: "NSP를 등록하면 자동 분석됩니다.";
    in-out property <bool> patch-analysis-ready: false;
    in-out property <bool> patch-analyzing: false;
    in-out property <bool> patch-version-enabled: false;
    in-out property <bool> analyze-result-ready: false;
    in-out property <bool> analyze-analyzing: false;
    in-out property <bool> analyze-stop-requested: false;
    in-out property <int> analyze-inner-tab: 0;
    in-out property <string> analyze-game-title: "";
    in-out property <string> analyze-title-id: "";
    in-out property <string> analyze-package-type: "";
    in-out property <string> analyze-publisher: "";
    in-out property <string> analyze-display-version: "";
    in-out property <string> analyze-age-rating: "";
    in-out property <string> analyze-build-kind: "";
    in-out property <[StandardListViewItem]> analyze-languages: [];
    in-out property <[string]> analyze-language-titles: [];
    in-out property <[string]> analyze-language-publishers: [];
    in-out property <image> analyze-icon;
    in-out property <bool> analyze-has-icon: false;
    in-out property <[TreeRow]> analyze-file-rows: [];
    in-out property <[ContentRow]> analyze-base-rows: [];
    in-out property <[ContentRow]> analyze-update-rows: [];
    in-out property <[ContentRow]> analyze-dlc-rows: [];
    in-out property <string> target-format: "NSP";
    in-out property <string> zip-password: "";
    in-out property <string> required-system-version: "";
    in-out property <string> required-system-version-display: "";
    in-out property <string> patch-current-system-version: "";
    in-out property <[FirmwareChoice]> firmware-choices: [];
    in-out property <bool> firmware-menu-open: false;
    in-out property <string> title-english: "";
    in-out property <string> title-japanese: "";
    in-out property <string> title-korean: "";
    in-out property <string> title-icon: "";
    in-out property <image> title-current-image;
    in-out property <image> title-new-image;
    in-out property <bool> title-has-current-image: false;
    in-out property <bool> title-has-new-image: false;
    in-out property <bool> title-analyzing: false;
    in-out property <bool> title-analysis-done: false;
    in-out property <bool> busy: false;
    in-out property <bool> stop-requested: false;
    // Help > About displays the official Slint attribution widget.
    in-out property <bool> about-open: false;
    in-out property <string> about-details: "";
    // Stage53: purely read-only Program publication recovery inspection.
    in-out property <bool> recovery-open: false;
    in-out property <bool> recovery-loading: false;
    in-out property <string> recovery-root: "";
    in-out property <int> recovery-count: 0;
    in-out property <[string]> recovery-lines: [];
    private property <bool> tab-locked: root.busy || root.patch-analyzing || root.title-analyzing || root.extract-analyzing || root.analyze-analyzing;

    callback choose-input();
    callback choose-input-folder();
    callback remove-input(int);
    callback clear-input();
    callback choose-patches();
    callback choose-patch-folder();
    callback remove-patch(int);
    callback clear-patches();
    callback choose-output();
    callback choose-title-icon();
    callback analyze-title();
    callback analyze-patch();
    callback analyze-extract();
    callback analyze-package();
    callback stop-analyze();
    callback toggle-extract-row(int);
    callback select-tab(int);
    callback start-operation(int);
    callback stop-operation();
    callback clear-log();
    callback reset-current();
    callback exit-app();
    callback show-about();
    callback open-updates();
    callback show-recovery();
    callback refresh-recovery();
    callback choose-recovery-root();

    VerticalLayout {
        padding: 0px; spacing: 0px;
        Rectangle {
            height: 22px;
            background: #f0f0f0;
            Image {
                width: parent.width; height: parent.height;
                source: root.menu-open == 1 || file-menu-touch.has-hover ? @image-url("legacy_assets/menubar_file_active.png") :
                    (root.menu-open == 2 || help-menu-touch.has-hover ? @image-url("legacy_assets/menubar_help_active.png") : @image-url("legacy_assets/menubar.png"));
            }
            Rectangle {
                x: 0px; y: 0px; width: 40px; height: 21px;
                background: transparent;
                file-menu-touch := TouchArea { x:0px; y:0px; width:parent.width; height:parent.height; clicked => { root.menu-open = root.menu-open == 1 ? 0 : 1; } }
            }
            Rectangle {
                x: 40px; y: 0px; width: 52px; height: 21px;
                background: transparent;
                help-menu-touch := TouchArea { x:0px; y:0px; width:parent.width; height:parent.height; clicked => { root.menu-open = root.menu-open == 2 ? 0 : 2; } }
            }
        }
        HorizontalLayout {
            height: 717px;
            padding: 10px; spacing: 5px;
            Rectangle {
                width: 835px;
                background: #f0f0f0;
                main-tabs := Rectangle {
                    width: parent.width; height: parent.height;
                    background: #f9f9f9;
                    border-width: 1px; border-color: #e5e5e5;
                    Rectangle {
                        x: 0px; y: 0px; width: parent.width; height: 24px; background: #f0f0f0;
                        if root.tab-locked && root.selected-tab == 0 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_busy_0.png"); }
                        if root.tab-locked && root.selected-tab == 1 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_busy_1.png"); }
                        if root.tab-locked && root.selected-tab == 2 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_busy_2.png"); }
                        if root.tab-locked && root.selected-tab == 3 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_busy_3.png"); }
                        if root.tab-locked && root.selected-tab == 4 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_busy_4.png"); }
                        if root.tab-locked && root.selected-tab == 5 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_busy_5.png"); }
                        if root.tab-locked && root.selected-tab == 6 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_busy_6.png"); }
                        if root.tab-locked && root.selected-tab == 7 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_busy_7.png"); }
                        if root.tab-locked && root.selected-tab == 8 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_busy_8.png"); }
                        if !root.tab-locked && root.selected-tab == 0 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_0.png"); }
                        if !root.tab-locked && root.selected-tab == 1 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_1.png"); }
                        if !root.tab-locked && root.selected-tab == 2 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_2.png"); }
                        if !root.tab-locked && root.selected-tab == 3 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_3.png"); }
                        if !root.tab-locked && root.selected-tab == 4 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_4.png"); }
                        if !root.tab-locked && root.selected-tab == 5 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_5.png"); }
                        if !root.tab-locked && root.selected-tab == 6 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_6.png"); }
                        if !root.tab-locked && root.selected-tab == 7 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_7.png"); }
                        if !root.tab-locked && root.selected-tab == 8 : Image { x:0px; y:0px; width:472px; height:24px; source:@image-url("legacy_assets/tabbar_8.png"); }
                        TouchArea { x:0px; y:0px; width:48px; height:24px; enabled:!root.tab-locked || root.selected-tab == 0; clicked => { root.select-tab(0); } }
                        TouchArea { x:48px; y:0px; width:60px; height:24px; enabled:!root.tab-locked || root.selected-tab == 1; clicked => { root.select-tab(1); } }
                        TouchArea { x:108px; y:0px; width:48px; height:24px; enabled:!root.tab-locked || root.selected-tab == 2; clicked => { root.select-tab(2); } }
                        TouchArea { x:156px; y:0px; width:48px; height:24px; enabled:!root.tab-locked || root.selected-tab == 3; clicked => { root.select-tab(3); } }
                        TouchArea { x:204px; y:0px; width:48px; height:24px; enabled:!root.tab-locked || root.selected-tab == 4; clicked => { root.select-tab(4); } }
                        TouchArea { x:252px; y:0px; width:48px; height:24px; enabled:!root.tab-locked || root.selected-tab == 5; clicked => { root.select-tab(5); } }
                        TouchArea { x:300px; y:0px; width:76px; height:24px; enabled:!root.tab-locked || root.selected-tab == 6; clicked => { root.select-tab(6); } }
                        TouchArea { x:376px; y:0px; width:48px; height:24px; enabled:!root.tab-locked || root.selected-tab == 7; clicked => { root.select-tab(7); } }
                        TouchArea { x:424px; y:0px; width:48px; height:24px; enabled:!root.tab-locked || root.selected-tab == 8; clicked => { root.select-tab(8); } }
                    }
                    Rectangle {
                        x: 2px; y: 25px; width: 829px; height: 668px;
                        background: #f9f9f9; clip: true;
                        if root.selected-tab == 0 : Rectangle {
                            width: parent.width; height: parent.height; background: #f9f9f9;
                            FieldLabel { x: 20px; y: 10px; width: 789px; height: 16px; text: "NSP / XCI / NSZ / XCZ 파일 또는 폴더"; }
                            PathBox { x: 20px; y: 32px; width: 705px; height: 136px; model: root.input-items; current-item <=> root.input-current; }
                            LegacyButton { x: 731px; y: 32px; width: 78px; height: 30px; text: "+ 파일 추가"; clicked => { root.choose-input(); } }
                            LegacyButton { x: 731px; y: 68px; width: 78px; height: 30px; text: "+ 폴더 추가"; clicked => { root.choose-input-folder(); } }
                            LegacyButton { x: 731px; y: 104px; width: 78px; height: 30px; text: "- 선택 삭제"; clicked => { root.remove-input(root.input-current); } }

                            FieldLabel { x: 20px; y: 184px; width: 789px; height: 16px; text: "패치 파일 (ZIP 또는 폴더)"; }
                            PathBox { x: 20px; y: 206px; width: 705px; height: 136px; model: root.patch-items; current-item <=> root.patch-current; }
                            LegacyButton { x: 731px; y: 206px; width: 78px; height: 30px; text: "+ 파일 추가"; clicked => { root.choose-patches(); } }
                            LegacyButton { x: 731px; y: 242px; width: 78px; height: 30px; text: "+ 폴더 추가"; clicked => { root.choose-patch-folder(); } }
                            LegacyButton { x: 731px; y: 278px; width: 78px; height: 30px; text: "- 선택 삭제"; clicked => { root.remove-patch(root.patch-current); } }

                            SectionLabel { x: 20px; y: 358px; width: 789px; height: 20px; text: "NCA 감지"; }
                            Rectangle {
                                x: 20px; y: 384px; width: 789px; height: 100px; background: #ffffff; border-width: 1px; border-color: #b8b8b8;
                                Text { x: 7px; y: 6px; text: root.patch-analysis-text; color: #555555; font-size: 12px; wrap: word-wrap; }
                            }
                            FieldLabel { x: 20px; y: 490px; width: 109px; height: 22px; text: "ZIP 암호 (있는 경우)"; }
                            LegacyLineEdit { x: 135px; y: 490px; width: 200px; height: 22px; text <=> root.zip-password; }
                            FieldLabel { x: 20px; y: 518px; width: 156px; height: 22px; text: "필요 펌웨어 버전 (버전 무시)"; }
                            LegacyRequiredVersion { x: 182px; y: 518px; width: 160px; height: 22px; text <=> root.required-system-version; display-text: root.required-system-version-display; enabled: root.patch-version-enabled; clicked => { root.firmware-menu-open = !root.firmware-menu-open; } }
                            OutputFolderRow { x: 20px; y: 546px; width: 789px; height: 32px; output-dir <=> root.output-dir; choose => { root.choose-output(); } }
                            QtCheckBox { x: 513px; y: 594px; width: 171px; height: 20px; text: "작업 완료 시 알림창 띄우기"; checked <=> root.notify-done; }
                            QtCheckBox { x: 690px; y: 594px; width: 119px; height: 20px; text: "작업 후 로그 저장"; checked <=> root.save-log; }
                            LegacyButton { x: 20px; y: 620px; width: 392px; height: 38px; text: "초기화"; clicked => { root.reset-current(); } }
                            if !root.busy : BlueAction { x: 418px; y: 621px; width: 391px; height: 36px; text: "빌드하기"; action-enabled: root.patch-analysis-ready; clicked => { root.start-operation(0); } }
                            if root.busy : RedAction { x: 418px; y: 621px; width: 391px; height: 36px; text: "중지"; action-enabled:!root.stop-requested; clicked => { root.stop-operation(); } }
                            if root.input-items.length == 0 : Image { x:20px; y:384px; width:789px; height:100px; source:@image-url("legacy_assets/nca_empty.png"); }
                            LegacyTripleStack { x:731px; y:32px; width:78px; height:102px; add-file => { root.choose-input(); } add-folder => { root.choose-input-folder(); } remove-selected => { root.remove-input(root.input-current); } }
                            LegacyTripleStack { x:731px; y:206px; width:78px; height:102px; patch-stack:true; add-file => { root.choose-patches(); } add-folder => { root.choose-patch-folder(); } remove-selected => { root.remove-patch(root.patch-current); } }
                            if root.firmware-menu-open : TouchArea { x:0px; y:0px; width:parent.width; height:parent.height; clicked => { root.firmware-menu-open = false; } }
                            if root.firmware-menu-open && root.patch-version-enabled : Rectangle {
                                x:182px; y:540px; width:160px; height:min(root.firmware-choices.length * 18px + 2px, 218px);
                                background:#ffffff; border-width:1px; border-color:#808080; clip:true;
                                ListView {
                                    x:1px; y:1px; width:158px; height:parent.height - 2px;
                                    for choice[index] in root.firmware-choices : Rectangle {
                                        width:158px; height:18px; background:choice-touch.has-hover ? #cce8ff : #ffffff;
                                        Text { x:3px; width:152px; height:18px; text:choice.label; color:#000000; font-family:"맑은 고딕"; font-size:12px; vertical-alignment:center; overflow:elide; }
                                        choice-touch := TouchArea { width:parent.width; height:parent.height; clicked => { root.required-system-version = choice.value; root.required-system-version-display = choice.label; root.firmware-menu-open = false; } }
                                    }
                                }
                            }
}
                        if root.selected-tab == 1 : Rectangle {
                            width: parent.width; height: parent.height; background: #f9f9f9;
                            FieldLabel { x:20px; y:10px; width:789px; height:16px; text:"NSP / XCI / NSZ / XCZ 파일"; }
                            PathBox { x:20px; y:32px; width:717px; height:35px; model:root.input-items; current-item <=> root.input-current; }
                            LegacyButton { x:743px; y:34px; width:66px; height:30px; text:"파일 찾기"; enabled: !root.title-analyzing && !root.busy; clicked => { root.choose-input(); } }
                            SectionLabel { x:20px; y:98px; width:789px; height:20px; text:"언어별 타이틀 및 로고 수정"; }
                            FieldLabel { x:20px; y:124px; width:100px; height:22px; text:"영어"; }
                            LegacyLineEdit { x:126px; y:124px; width:683px; height:22px; text <=> root.title-english; enabled: root.input-items.length > 0 && !root.busy && !root.title-analyzing; }
                            FieldLabel { x:20px; y:152px; width:100px; height:22px; text:"일본어"; }
                            LegacyLineEdit { x:126px; y:152px; width:683px; height:22px; text <=> root.title-japanese; enabled: root.input-items.length > 0 && !root.busy && !root.title-analyzing; }
                            FieldLabel { x:20px; y:180px; width:100px; height:22px; text:"한국어"; }
                            LegacyLineEdit { x:126px; y:180px; width:683px; height:22px; text <=> root.title-korean; enabled: root.input-items.length > 0 && !root.busy && !root.title-analyzing; }
                            Rectangle {
                                x:20px; y:218px; width:175px; height:175px; background:#f9f9f9; border-width:2px; border-color:#f0f0f0; border-radius:8px;
                                if root.title-has-current-image : Image { x:0px; y:0px; width:parent.width; height:parent.height; source:root.title-current-image; image-fit:fill; }
                                if !root.title-has-current-image : Text {
                                    text: root.title-analyzing ? "분석 중..." : (root.title-analysis-done ? "로고 없음\n(클릭하여 선택)" : "원본 로고\n(파일 없음)");
                                    color:#777; horizontal-alignment:center; vertical-alignment:center;
                                }
                                TouchArea { x:0px; y:0px; width:parent.width; height:parent.height; enabled: root.input-items.length > 0 && !root.title-analyzing && !root.busy; clicked => { root.choose-title-icon(); } }
                            }
                            if root.title-has-new-image : Text { x:215px; y:280px; width:38px; height:75px; text:">"; font-family:"Consolas"; font-size:32px; font-weight:700; color:#8b949e; horizontal-alignment:center; vertical-alignment:center; }
                            if root.title-has-new-image : Rectangle {
                                x:273px; y:230px; width:175px; height:175px; background:#f9f9f9; border-width:2px; border-color:#838383; border-radius:8px;
                                Image { x:0px; y:0px; width:parent.width; height:parent.height; source:root.title-new-image; image-fit:fill; }
                                TouchArea { x:0px; y:0px; width:parent.width; height:parent.height; enabled:!root.busy; clicked => { root.choose-title-icon(); } }
                            }
                            OutputFolderRow { x:20px; y:546px; width:789px; height:32px; output-dir <=> root.output-dir; choose => { root.choose-output(); } }
                            QtCheckBox { x:638px; y:594px; width:171px; height:20px; text:"작업 완료 시 알림창 띄우기"; checked <=> root.notify-done; }
                            LegacyButton { x:20px; y:620px; width:392px; height:38px; text:"초기화"; enabled: !root.title-analyzing && !root.busy; clicked => { root.reset-current(); } }
                            if !root.busy : BlueAction { x:418px; y:621px; width:391px; height:36px; text:"빌드하기"; action-enabled: root.input-items.length > 0 && !root.title-analyzing; clicked => { root.start-operation(1); } }
                            if root.busy : RedAction { x:418px; y:621px; width:391px; height:36px; text:"중지"; action-enabled:!root.stop-requested; clicked => { root.stop-operation(); } }

                            if root.input-items.length == 0 : Image { x:20px; y:98px; width:789px; height:307px; source:@image-url("legacy_assets/title_empty_panel.png"); }
}
                        if root.selected-tab == 2 : Rectangle {
                            width:parent.width; height:parent.height; background:#f9f9f9;
                            FieldLabel { x:20px; y:10px; width:789px; height:16px; text:"NSP / XCI / NSZ / XCZ 파일"; }
                            PathBox { x:20px; y:32px; width:717px; height:35px; model:root.input-items; current-item <=> root.input-current; }
                            LegacyButton { x:743px; y:34px; width:66px; height:30px; text:"파일 찾기"; enabled:!root.extract-analyzing && !root.busy; clicked => { root.choose-input(); } }
                            SectionLabel { x:20px; y:93px; width:789px; height:20px; text:"내부 구조 (파일 리스트)"; }
                            PlaceholderTree { x:20px; y:119px; width:789px; height:385px; header:"파일명                                      크기            오프셋"; body: ""; rows:root.extract-rows; row-clicked(index) => { root.toggle-extract-row(index); } }
                            QtCheckBox { x:20px; y:510px; width:789px; height:20px; text:"NCA 파일 내부까지 분해"; checked <=> root.unpack-nca; enabled:!root.extract-analyzing && !root.busy; }
                            OutputFolderRow { x:20px; y:546px; width:789px; height:32px; output-dir <=> root.output-dir; choose => { root.choose-output(); } }
                            QtCheckBox { x:638px; y:594px; width:171px; height:20px; text:"작업 완료 시 알림창 띄우기"; checked <=> root.notify-done; }
                            LegacyButton { x:20px; y:620px; width:392px; height:38px; text:"초기화"; enabled:!root.extract-analyzing && !root.busy; clicked => { root.reset-current(); } }
                            if !root.busy : BlueAction { x:418px; y:621px; width:391px; height:36px; text:"선택 항목 분해"; action-enabled: root.extract-rows.length > 0 && !root.extract-analyzing; clicked => { root.start-operation(2); } }
                            if root.busy : RedAction { x:418px; y:621px; width:391px; height:36px; text:"중지"; action-enabled:!root.stop-requested; clicked => { root.stop-operation(); } }
}
                        if root.selected-tab == 3 : Rectangle {
                            width:parent.width; height:parent.height; background:#f9f9f9;
                            FieldLabel { x:20px; y:10px; width:789px; height:16px; text:"NSP / XCI / NSZ / XCZ 파일"; }
                            PathBox { x:20px; y:34px; width:715px; height:35px; model:root.input-items; current-item <=> root.input-current; }
