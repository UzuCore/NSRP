component StatusProgress inherits Rectangle {
    in property <float> progress: 0;
    width: 180px;
    background: transparent;
    QtProgressBar { x: 0px; y: 4px; width: 180px; height: 14px; progress: root.progress; }
}
component ResourceLabel inherits HorizontalLayout {
    in property <string> text;
    in property <int> char-count;
    width: root.text == "" ? 27px : root.char-count * 7px + 20px;
    height: 16px;
    vertical-stretch: 0;
    padding-left: 10px;
    padding-right: 10px;
    Text {
        text: root.text;
        color: #000000;
        font-family: "Consolas";
        font-size: 12px;
        vertical-alignment: center;
    }
}
component PathBox inherits Rectangle {
    in property <[StandardListViewItem]> model;
    in-out property <int> current-item: -1;
    callback row-selected(int);
    private property <bool> known-size:
        (root.width == 705px && (root.height == 136px || root.height == 464px || root.height == 438px || root.height == 462px || root.height == 426px || root.height == 500px)) ||
        (root.width == 717px && root.height == 35px) || (root.width == 715px && root.height == 35px) ||
        (root.width == 478px && root.height == 192px);
    background: root.known-size ? transparent : #ffffff;
    border-width: root.known-size ? 0px : 1px;
    border-color: #b8b8b8;

    if root.width == 705px && root.height == 136px : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/list_705x136.png"); }
    if root.width == 717px && root.height == 35px : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/list_717x35.png"); }
    if root.width == 715px && root.height == 35px : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/list_715x35.png"); }
    if root.width == 478px && root.height == 192px : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/list_478x192.png"); }
    if root.width == 705px && root.height == 464px : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/list_705x464.png"); }
    if root.width == 705px && root.height == 438px : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/list_705x438.png"); }
    if root.width == 705px && root.height == 462px : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/list_705x462.png"); }
    if root.width == 705px && root.height == 426px : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/list_705x426.png"); }
    if root.width == 705px && root.height == 500px : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/list_705x500.png"); }

    if root.model.length > 0 : ListView {
        x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
        for item[index] in root.model : Rectangle {
            width: root.width - 4px;
            height: 18px;
            background: #ffffff;
            if index == root.current-item && root.width == 705px : Image { width: parent.width; height: parent.height; source: @image-url("legacy_assets/list_selected_row_705.png"); }
            if index == root.current-item && root.width == 717px : Image { width: parent.width; height: parent.height; source: @image-url("legacy_assets/list_selected_row_717.png"); }
            if index == root.current-item && root.width == 715px : Image { width: parent.width; height: parent.height; source: @image-url("legacy_assets/list_selected_row_715.png"); }
            if index == root.current-item && root.width != 705px && root.width != 717px && root.width != 715px : Rectangle { width: parent.width; height: parent.height; background:#d9d9d9; }
            Text {
                x: 2px; width: parent.width - 4px; height: parent.height;
                text: item.text;
                color: #000000;
                font-family: "맑은 고딕";
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            row-touch := TouchArea {
                x:0px; y:0px; width:parent.width; height:parent.height;
                clicked => { root.current-item = index; root.row-selected(index); }
            }
        }
    }
}
component LegacyLineEdit inherits Rectangle {
    in-out property <string> text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    background: transparent;
    if root.width <= 201px : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/lineedit_200.png"); }
    if root.width == 482px : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/lineedit_482.png"); }
    if root.width == 560px : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/lineedit_560.png"); }
    if root.width == 613px : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/lineedit_613.png"); }
    if root.width == 635px : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/lineedit_635.png"); }
    if root.width == 683px : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/lineedit_683.png"); }
    if root.width > 201px && root.width != 482px && root.width != 560px && root.width != 613px && root.width != 635px && root.width != 683px : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/lineedit_613.png"); }
    TextInput {
        x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
        text <=> root.text;
        enabled: root.enabled;
        read-only: root.read-only;
        single-line: true;
        vertical-alignment: center;
        color: root.enabled ? #000000 : #808080;
        font-family: "맑은 고딕";
        font-size: 12px;
    }
}

component LegacyRequiredVersion inherits Rectangle {
    in-out property <string> text;
    in property <string> display-text;
    in property <bool> enabled;
    callback clicked();
    background: transparent;
    if !root.enabled : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/combo_disabled_160.png"); }
    if root.enabled : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/combo_active_160.png"); }
    if root.enabled : Text {
        x:5px; y:0px; width:parent.width - 27px; height:parent.height;
        text:root.display-text; color:#000000; font-family:"맑은 고딕"; font-size:12px;
        vertical-alignment:center; overflow:elide;
    }
    TouchArea { width:parent.width; height:parent.height; enabled:root.enabled; clicked => { root.clicked(); } }
}
component OutputFolderRow inherits Rectangle {
    in-out property <string> output-dir;
    callback choose();
    height: 32px;
    background: transparent;
    FieldLabel { x:0px; y:0px; width:70px; height:32px; text:"출력 폴더"; }
    LegacyLineEdit { x:78px; y:5px; width:parent.width - 176px; height:22px; text <=> root.output-dir; read-only:true; }
    LegacyButton { x:parent.width - 90px; y:4px; width:90px; height:24px; text:"폴더 선택"; clicked => { root.choose(); } }
}
component BlueAction inherits Rectangle {
    in property <string> text;
    in property <bool> action-enabled: true;
    callback clicked();
    private property <bool> legacy-active: root.action-enabled && (root.text == "변환 시작" || root.text == "압축 시작" || root.text == "압축 해제 시작" || root.text == "병합 시작" || root.text == "분할 시작");
    height: 36px;
    background: transparent;

    if !root.action-enabled && root.text == "빌드하기" : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/action_build_disabled.png"); }
    if !root.action-enabled && root.text == "선택 항목 분해" : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/action_extract_disabled.png"); }
    if !root.action-enabled && root.text == "분석 시작" : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/action_analyze_disabled.png"); }
    if !root.action-enabled && root.text == "헤더 검사" : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/action_verify_disabled.png"); }

    if root.action-enabled && root.text == "변환 시작" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/action_convert.png"); }
    if root.action-enabled && root.text == "압축 시작" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/action_compress.png"); }
    if root.action-enabled && root.text == "압축 해제 시작" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/action_decompress.png"); }
    if root.action-enabled && root.text == "병합 시작" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/action_merge.png"); }
    if root.action-enabled && root.text == "분할 시작" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/action_split.png"); }
    if root.action-enabled && root.text == "헤더 검사" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/action_verify.png"); }

    if root.action-enabled && !root.legacy-active : Rectangle {
        width: parent.width; height: parent.height;
        background: touch.has-hover ? #034ea2 : #1f6feb;
        border-radius: 4px;
        Text { text: root.text; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    touch := TouchArea { x:0px; y:0px; width:parent.width; height:parent.height; enabled: root.action-enabled; clicked => { root.clicked(); } }
}
component RedAction inherits Rectangle {
    in property <string> text;
    in property <bool> action-enabled: true;
    callback clicked();
    height: 36px;
    background: root.action-enabled ? (touch.has-hover ? #a01724 : #d73a49) : transparent;
    border-radius: 4px;
    if !root.action-enabled && root.width == 390px : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/action_stop_disabled_390.png"); }
    if !root.action-enabled && root.width == 391px : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/action_stop_disabled_391.png"); }
    if !root.action-enabled && root.width == 789px : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/action_stop_disabled_789.png"); }
    if root.action-enabled : Text { text: root.text; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { x:0px; y:0px; width:parent.width; height:parent.height; enabled:root.action-enabled; clicked => { root.clicked(); } }
}

export struct TreeRow {
    name: string,
    size: string,
    offset: string,
    selected: bool,
}

export struct ContentRow {
    title-id: string,
    version: string,
    system-version: string,
    build-id: string,
}

export struct FirmwareChoice {
    label: string,
    value: string,
}


component PlaceholderTree inherits Rectangle {
    in property <string> header;
    in property <string> body;
    in property <[TreeRow]> rows;
    callback row-clicked(int);
    private property <bool> legacy-empty: root.body == "" && root.rows.length == 0 && root.width == 789px && root.height == 385px;
    background: root.legacy-empty ? transparent : white;
    border-width: root.legacy-empty ? 0px : 1px;
    border-color: #b8b8b8;
    if root.legacy-empty : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/tree_extract_empty.png"); }
    if root.rows.length > 0 : Rectangle {
        width:parent.width; height:parent.height; background:#ffffff;
        Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/tree_extract_empty.png"); }
        ListView {
            x:1px; y:25px; width:parent.width - 2px; height:parent.height - 26px;
            for row[index] in root.rows : Rectangle {
                width:parent.width; height:18px; background:row.selected ? #d9d9d9 : #ffffff;
                Text { x:23px; width:293px; height:18px; text:row.name; color:#000000; font-family:"맑은 고딕"; font-size:12px; letter-spacing:0.2px; vertical-alignment:center; overflow:elide; }
                Text { x:324px; width:82px; height:18px; text:row.size; color:#000000; font-family:"맑은 고딕"; font-size:12px; vertical-alignment:center; overflow:elide; }
                Text { x:413px; width:367px; height:18px; text:row.offset; color:#000000; font-family:"맑은 고딕"; font-size:12px; vertical-alignment:center; overflow:elide; }
                TouchArea { width:parent.width; height:parent.height; clicked => { root.row-clicked(index); } }
            }
        }
    }
    if !root.legacy-empty : VerticalLayout {
        spacing: 0px;
        Rectangle { height: 28px; background: #f5f5f5; Text { x: 8px; text: root.header; color: #202124; font-size: 12px; vertical-alignment: center; } }
        Text { text: root.body; color: #777777; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
    }
}
component AnalyzeFileTree inherits Rectangle {
    in property <[TreeRow]> rows;
    background: transparent;
    Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/analyze_file_tree_empty.png"); }
    if root.rows.length > 0 : ListView {
        x:1px; y:25px; width:parent.width - 2px; height:parent.height - 26px;
        for row in root.rows : Rectangle {
            width:parent.width; height:18px; background:#ffffff;
            Text { x:23px; width:293px; height:18px; text:row.name; color:#000000; font-family:"맑은 고딕"; font-size:12px; letter-spacing:0.2px; vertical-alignment:center; overflow:elide; }
            Text { x:324px; width:82px; height:18px; text:row.size; color:#000000; font-family:"맑은 고딕"; font-size:12px; vertical-alignment:center; overflow:elide; }
            Text { x:413px; width:330px; height:18px; text:row.offset; color:#000000; font-family:"맑은 고딕"; font-size:12px; vertical-alignment:center; overflow:elide; }
        }
    }
}

component AnalyzeContentFields inherits Rectangle {
