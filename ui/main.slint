component LegacyThreadValue inherits Rectangle {
    in property <float> value;
    in property <int> core-count;
    background: transparent;
    if root.core-count == 12 && root.value == 1 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_1.png"); }
    if root.core-count == 12 && root.value == 2 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_2.png"); }
    if root.core-count == 12 && root.value == 3 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_3.png"); }
    if root.core-count == 12 && root.value == 4 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_4.png"); }
    if root.core-count == 12 && root.value == 5 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_5.png"); }
    if root.core-count == 12 && root.value == 6 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_6.png"); }
    if root.core-count == 12 && root.value == 7 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_7.png"); }
    if root.core-count == 12 && root.value == 8 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_8.png"); }
    if root.core-count == 12 && root.value == 9 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_9.png"); }
    if root.core-count == 12 && root.value == 10 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_10.png"); }
    if root.core-count == 12 && root.value == 11 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_11.png"); }
    if root.core-count == 12 && root.value == 12 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_12.png"); }
    if root.core-count == 12 && root.value == 13 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread_13.png"); }
    if root.core-count != 12 : Text { text: root.value > root.core-count ? "자동 (" + root.core-count + ")" : "" + Math.round(root.value); color:#202124; font-size:12px; font-weight:700; vertical-alignment:center; }
}

component QtProgressBar inherits Rectangle {
    in property <float> progress: 0;
    background: transparent;
    if root.progress <= 0 : Image { width: parent.width; height: parent.height; source: @image-url("legacy_assets/progress_0.png"); }
    if root.progress > 0 : Rectangle {
        width: parent.width; height: parent.height;
        background: #e6e6e6; border-width: 1px; border-color: #bcbcbc;
        Rectangle {
            x: 1px; y: 1px;
            width: max(0px, (parent.width - 2px) * min(1, max(0, root.progress)));
            height: parent.height - 2px; background: #06a0dc;
        }
        Text {
            text: "" + Math.round(min(1, max(0, root.progress)) * 100) + "%";
            color: #000000; font-size: 9px;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}

component LegacyButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    background: transparent;

    if root.text == "+ 파일 추가" : Image { width: parent.width; height: parent.height; source: @image-url("legacy_assets/btn_add_file.png"); }
    if root.text == "+ 폴더 추가" : Image { width: parent.width; height: parent.height; source: @image-url("legacy_assets/btn_add_folder.png"); }
    if root.text == "- 선택 삭제" : Image { width: parent.width; height: parent.height; source: @image-url("legacy_assets/btn_del_selected.png"); }
    if root.text == "- 모두 삭제" : Image { width: parent.width; height: parent.height; source: @image-url("legacy_assets/btn_clear_all.png"); }
    if root.text == "파일 찾기" : Image { width: parent.width; height: parent.height; source: @image-url("legacy_assets/btn_file_find.png"); }
    if root.text == "폴더 선택" : Image { width: parent.width; height: parent.height; source: @image-url("legacy_assets/btn_folder_select.png"); }
    if root.text == "초기화" && root.width >= 392px : Image { width: parent.width; height: parent.height; source: @image-url("legacy_assets/btn_reset_392.png"); }
    if root.text == "초기화" && root.width < 392px : Image { width: parent.width; height: parent.height; source: @image-url("legacy_assets/btn_reset_391.png"); }

    TouchArea { x:0px; y:0px; width:parent.width; height:parent.height; enabled: root.enabled; clicked => { root.clicked(); } }
}
component LegacyTripleStack inherits Rectangle {
    in property <bool> patch-stack:false; callback add-file(); callback add-folder(); callback remove-selected(); background:transparent;
    if !root.patch-stack : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/stack_patch_input.png"); }
    if root.patch-stack : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/stack_patch_patch.png"); }
    TouchArea { x:0px; y:0px; width:78px; height:30px; clicked=>{root.add-file();} }
    TouchArea { x:0px; y:36px; width:78px; height:30px; clicked=>{root.add-folder();} }
    TouchArea { x:0px; y:72px; width:78px; height:30px; clicked=>{root.remove-selected();} }
}
component LegacyFourStack inherits Rectangle {
