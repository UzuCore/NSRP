import { AboutSlint, LineEdit, ListView, Palette, ScrollView, StandardListView } from "std-widgets.slint";

component SectionLabel inherits Rectangle {
    in property <string> text;
    background: transparent;
    private property <bool> legacy: root.text == "NCA 감지" || root.text == "언어별 타이틀 및 로고 수정" || root.text == "내부 구조 (파일 리스트)";
    if root.text == "NCA 감지" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/section_nca.png"); }
    if root.text == "언어별 타이틀 및 로고 수정" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/section_title.png"); }
    if root.text == "내부 구조 (파일 리스트)" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/section_structure.png"); }
    if !root.legacy : Text { text:root.text; color:#202124; font-size:14px; font-weight:700; vertical-alignment:center; }
}
component FieldLabel inherits Rectangle {
    in property <string> text;
    in property <int> font-weight: 400;
    background: transparent;
    private property <bool> legacy:
        root.text == "출력 폴더" || root.text == "NSP / XCI / NSZ / XCZ 파일 또는 폴더" || root.text == "패치 파일 (ZIP 또는 폴더)" ||
        root.text == "ZIP 암호 (있는 경우)" || root.text == "필요 펌웨어 버전 (버전 무시)" || root.text == "NSP / XCI / NSZ / XCZ 파일" ||
        root.text == "영어" || root.text == "일본어" || root.text == "한국어" || root.text == "변환할 포맷:" || root.text == "NSP/XCI 파일 또는 폴더" ||
        root.text == "압축률" || root.text == "스레드" || root.text == "NSZ/XCZ 파일 또는 폴더" || root.text == "압축 해제 스레드" || root.text == "출력 포맷:";
    if root.text == "출력 폴더" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_output.png"); }
    if root.text == "NSP / XCI / NSZ / XCZ 파일 또는 폴더" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_package_folder.png"); }
    if root.text == "패치 파일 (ZIP 또는 폴더)" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_patch_files.png"); }
    if root.text == "ZIP 암호 (있는 경우)" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_zip.png"); }
    if root.text == "필요 펌웨어 버전 (버전 무시)" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_required.png"); }
    if root.text == "NSP / XCI / NSZ / XCZ 파일" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_package_file.png"); }
    if root.text == "영어" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_english.png"); }
    if root.text == "일본어" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_japanese.png"); }
    if root.text == "한국어" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_korean.png"); }
    if root.text == "변환할 포맷:" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_convert_format.png"); }
    if root.text == "NSP/XCI 파일 또는 폴더" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_compress_top.png"); }
    if root.text == "압축률" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_compression.png"); }
    if root.text == "스레드" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_thread.png"); }
    if root.text == "NSZ/XCZ 파일 또는 폴더" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_decompress_top.png"); }
    if root.text == "압축 해제 스레드" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_merge_thread.png"); }
    if root.text == "출력 포맷:" : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/label_output_format.png"); }
    if !root.legacy : Text { text:root.text; color:#202124; font-size:12px; font-weight:root.font-weight; vertical-alignment:center; }
}
component LegacyTooltip inherits Rectangle {
    in property <string> text;
    background: #ffffe1;
    border-width: 1px;
    border-color: #767676;
    border-radius: 2px;
    Text {
        x: 6px; y: 4px;
        width: parent.width - 12px; height: parent.height - 8px;
        text: root.text;
        color: #202020;
        font-family: "맑은 고딕";
        font-size: 11px;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}
component QtCheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    background: transparent;

    if root.text == "작업 완료 시 알림창 띄우기" && !root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_notify_off.png"); }
    if root.text == "작업 완료 시 알림창 띄우기" && root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_notify_on.png"); }
    if root.text == "작업 후 로그 저장" && !root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_save_log_off.png"); }
    if root.text == "작업 후 로그 저장" && root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_save_log_on.png"); }
    if root.text == "NCA 파일 내부까지 분해" && !root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_unpack_nca_off.png"); }
    if root.text == "NCA 파일 내부까지 분해" && root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_unpack_nca_on.png"); }
    if root.text == "출력 후 압축" && !root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_compress_after_off.png"); }
    if root.text == "출력 후 압축" && root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_compress_after_on.png"); }
    if root.text == "압축 후 원본 삭제" && !root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_remove_compress_off.png"); }
    if root.text == "압축 후 원본 삭제" && root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_remove_compress_on.png"); }
    if root.text == "블록 모드" && !root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_block_mode_off.png"); }
    if root.text == "블록 모드" && root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_block_mode_on.png"); }
    if root.text == "해제 후 원본 삭제" && !root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_remove_decompress_off.png"); }
    if root.text == "해제 후 원본 삭제" && root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_remove_decompress_on.png"); }
    if root.text == "타이틀 가져오기" && !root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_fetch_title_off.png"); }
    if root.text == "타이틀 가져오기" && root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/check_fetch_title_on.png"); }

}
component QtRadioButton inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    background: transparent;
    if root.text == "NSP" && root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/radio_nsp_on.png"); }
    if root.text == "NSP" && !root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/radio_nsp_off.png"); }
    if root.text == "XCI" && root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/radio_xci_on.png"); }
    if root.text == "XCI" && !root.checked : Image { width: parent.width; height: parent.height; source:@image-url("legacy_assets/radio_xci_off.png"); }
    TouchArea { x:0px; y:0px; width:parent.width; height:parent.height; enabled: root.enabled; clicked => { root.clicked(); } }
}
component QtSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value: minimum;
    private property <length> usable-width: max(1px, root.width - 14px);
    private property <length> handle-x: (root.value - root.minimum) / max(0.0001, root.maximum - root.minimum) * root.usable-width;
    private property <bool> exact-level: root.maximum == 23 && root.value >= 1 && root.value <= 23;
    private property <bool> exact-thread: root.maximum == 13 && root.value >= 1 && root.value <= 13;
    background: transparent;
    if root.maximum == 23 && root.value == 1 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_1.png"); }
    if root.maximum == 23 && root.value == 2 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_2.png"); }
    if root.maximum == 23 && root.value == 3 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_3.png"); }
    if root.maximum == 23 && root.value == 4 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_4.png"); }
    if root.maximum == 23 && root.value == 5 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_5.png"); }
    if root.maximum == 23 && root.value == 6 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_6.png"); }
    if root.maximum == 23 && root.value == 7 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_7.png"); }
    if root.maximum == 23 && root.value == 8 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_8.png"); }
    if root.maximum == 23 && root.value == 9 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_9.png"); }
    if root.maximum == 23 && root.value == 10 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_10.png"); }
    if root.maximum == 23 && root.value == 11 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_11.png"); }
    if root.maximum == 23 && root.value == 12 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_12.png"); }
    if root.maximum == 23 && root.value == 13 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_13.png"); }
    if root.maximum == 23 && root.value == 14 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_14.png"); }
    if root.maximum == 23 && root.value == 15 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_15.png"); }
    if root.maximum == 23 && root.value == 16 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_16.png"); }
    if root.maximum == 23 && root.value == 17 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_17.png"); }
    if root.maximum == 23 && root.value == 18 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_18.png"); }
    if root.maximum == 23 && root.value == 19 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_19.png"); }
    if root.maximum == 23 && root.value == 20 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_20.png"); }
    if root.maximum == 23 && root.value == 21 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_21.png"); }
    if root.maximum == 23 && root.value == 22 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_22.png"); }
    if root.maximum == 23 && root.value == 23 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_level_23.png"); }
    if root.maximum == 13 && root.value == 1 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_1.png"); }
    if root.maximum == 13 && root.value == 2 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_2.png"); }
    if root.maximum == 13 && root.value == 3 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_3.png"); }
    if root.maximum == 13 && root.value == 4 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_4.png"); }
    if root.maximum == 13 && root.value == 5 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_5.png"); }
    if root.maximum == 13 && root.value == 6 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_6.png"); }
    if root.maximum == 13 && root.value == 7 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_7.png"); }
    if root.maximum == 13 && root.value == 8 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_8.png"); }
    if root.maximum == 13 && root.value == 9 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_9.png"); }
    if root.maximum == 13 && root.value == 10 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_10.png"); }
    if root.maximum == 13 && root.value == 11 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_11.png"); }
    if root.maximum == 13 && root.value == 12 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_12.png"); }
    if root.maximum == 13 && root.value == 13 : Image { width:parent.width; height:parent.height; source:@image-url("legacy_assets/slider_thread_13.png"); }
    if !root.exact-level && !root.exact-thread : Rectangle { x:7px; y:9px; width:root.width - 14px; height:4px; background:#e0e0e0; border-radius:2px; }
    if !root.exact-level && !root.exact-thread : Rectangle { x:7px; y:9px; width:max(0px,root.handle-x); height:4px; background:#0969da; border-radius:2px; }
    if !root.exact-level && !root.exact-thread : Rectangle { x:root.handle-x; y:4px; width:14px; height:14px; background:slider-touch.has-hover ? #f0f7ff : white; border-width:2px; border-color:slider-touch.has-hover ? #034ea2 : #0969da; border-radius:7px; }
    slider-touch := TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        clicked => { root.value = Math.round(root.minimum + max(0px,min(root.usable-width,self.mouse-x - 7px))/root.usable-width*(root.maximum - root.minimum)); }
        moved => { if (self.pressed) { root.value = Math.round(root.minimum + max(0px,min(root.usable-width,self.mouse-x - 7px))/root.usable-width*(root.maximum - root.minimum)); } }
    }
}
